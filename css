/* styles.css */

/* 通用样式 */
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
.no-scrollbar::-webkit-scrollbar { width: 0; height: 0; }
#canvasArea { position: relative; }

/* 画布元素（缩放/旋转/手柄） */
.canvas-item {
  cursor: move;
  user-select: none;
  touch-action: none;
  transition: box-shadow .12s, transform .08s;
  border-radius: 8px;
  position: absolute;
  transform-origin: center center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px;
  background: rgba(255,255,255,0);
}
.canvas-item:hover {
  box-shadow: 0 10px 22px rgba(2,6,23,0.06);
  border: 1px dashed rgba(99,102,241,0.14);
}
.handle {
  position: absolute;
  width: 24px;
  height: 24px;
  border-radius: 999px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6px 18px rgba(2,6,23,0.08);
  border: 1px solid rgba(0,0,0,0.06);
  z-index: 9999;
  touch-action: none;
}
.rotate-handle { top: -12px; right: -12px; cursor: grab; }
.scale-handle  { bottom: -12px; right: -12px; cursor: nwse-resize; }
.delete-btn {
  position: absolute;
  top: -12px;
  left: -12px;
  width: 24px;
  height: 24px;
  border-radius: 999px;
  background: #ef4444;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  box-shadow: 0 6px 14px rgba(0,0,0,0.12);
  border: none;
  z-index: 9999;
  cursor: pointer;
}

/* 手机模式 */
body.mobile-mode header { position: fixed; top: 0; left: 0; right: 0; z-index: 60; }
body.mobile-mode .max-w-7xl { padding-bottom: 88px; }
body.mobile-mode #sideDrawer,
body.mobile-mode #drawerOverlay { display: none !important; }
.mobile-bottom-nav { display: none; }
body.mobile-mode .mobile-bottom-nav {
  display: flex;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72px;
  background: linear-gradient(180deg,#ffffff,#fbfdff);
  border-top: 1px solid rgba(15,23,42,0.04);
  align-items: center;
  justify-content: space-around;
  z-index: 70;
  padding: 8px 10px;
  box-shadow: 0 -12px 40px rgba(2,6,23,0.06);
}
.mobile-bottom-nav button {
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  background:transparent;
  border:none;
  color:#475569;
  font-size:12px;
  width:60px;
  height:60px;
  border-radius:12px;
}
.mobile-bottom-nav button.active {
  background: linear-gradient(180deg,#eef2ff,#eae6ff);
  color:#4f46e5;
  box-shadow:0 10px 30px rgba(79,70,229,0.08);
}
.mobile-panel { display: none; }
body.mobile-mode .mobile-panel.active { display:block; }

/* FULLSCREEN */
.fullscreen-overlay {
  position: fixed;
  inset: 0;
  background: rgba(4,6,10,0.6);
  z-index: 120;
  display:flex;
  align-items:center;
  justify-content:center;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
.fullscreen-card {
  width: 100%;
  max-width: 900px;
  height: 100%;
  background: linear-gradient(180deg,#fff,#f7fffb);
  border-radius: 12px 12px 0 0;
  position: relative;
  overflow: hidden;
  display:flex;
  flex-direction:column;
}
.fullscreen-canvas { position: relative; flex:1; background: transparent; overflow: hidden; }
.fullscreen-bottom-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120px;
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(15,23,42,0.06) 100%);
  pointer-events: none;
}
.fullscreen-toolbar {
  height: 56px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 12px;
  border-bottom: 1px solid rgba(0,0,0,0.04);
  background: linear-gradient(180deg, rgba(255,255,255,0.9), rgba(255,255,255,0.6));
}

.gesture-hint {
  position: absolute;
  left: 50%;
  bottom: 26%;
  transform: translateX(-50%);
  background: rgba(0,0,0,0.72);
  color: white;
  padding: 12px 16px;
  border-radius: 999px;
  display:flex;
  gap:10px;
  align-items:center;
  font-size:13px;
  box-shadow: 0 12px 30px rgba(2,6,23,0.32);
  opacity: 0;
  animation: hintIn .5s ease forwards;
  z-index: 130;
  pointer-events: none;
}
.gesture-hint .dot {
  width:44px; height:44px; border-radius:8px; background:linear-gradient(180deg,#fff,#f3f4f6); display:flex; align-items:center; justify-content:center; color:#111827; font-size:18px;
}
@keyframes hintIn { 0% { transform: translate(-50%, 6px) scale(.96); opacity:0 } 100% { transform: translate(-50%, 0) scale(1); opacity:1 } }
@keyframes hintOut { from { opacity:1; transform: translate(-50%,0) scale(1); } to { opacity:0; transform: translate(-50%,-6px) scale(.98); } }

.fs-btn { padding:8px 12px; border-radius:10px; background:rgba(255,255,255,0.9); border:1px solid rgba(0,0,0,0.04); box-shadow: 0 8px 20px rgba(2,6,23,0.06); cursor:pointer; }
.fs-close { font-weight:700; color:#0f172a; }

/* Collection modal */
.collection-modal { position: fixed; inset: 0; display:flex; align-items:center; justify-content:center; background: rgba(2,6,23,0.45); z-index:200; }
.collection-card { width: min(860px,96%); max-height:86vh; overflow:auto; background:white; border-radius:12px; padding:16px; box-shadow:0 24px 60px rgba(2,6,23,0.3); }
